{
  "name": "lms-saver",
  "displayName": "Lms saver",
  "version": "0.0.3",
  "description": "extension description",
  "author": "author",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "crypto-browserify": "^3.12.1",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "prettier": "3.2.4",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "5.3.3",
    "util": "^0.12.5"
  },
  "browser": {
    "sharp": false
  },
  "manifest": {
    "permissions": [
      "nativeMessaging",
      "storage",
      "tabs",
      "downloads",
      "identity"
    ],
    "oauth2": {
      "client_id": "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/tasks",
        "https://www.googleapis.com/auth/userinfo.email"
      ]
    },
    "host_permissions": [
      "https://*/*",
      "http://localhost:8765/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "lms-saver@kanazawa-u.example",
        "strict_min_version": "115.0",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    }
  }
}
